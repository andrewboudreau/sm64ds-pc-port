diff --git a/src/fabs.c b/src/fabs.c
--- a/src/fabs.c
+++ b/src/fabs.c
@@ -1,7 +1,9 @@
 /* MSL fabs: clear the sign bit in x's high word. */
+#ifndef _MSC_VER   /* host: the C library's fabs, the same sign-bit clear; MSVC refuses to define the intrinsic (C2169) */
 double fabs(double x) {
     int a = (int)(&x);
     int *p = (int *)(a + 4);
     *p &= 0x7fffffff;
     return x;
 }
+#endif
