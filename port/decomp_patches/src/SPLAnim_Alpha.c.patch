+   (c0000094). hal/cstd_div.c's ds_idiv / ds_imod are that helper's answers. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+int ds_idiv(int, int);
+int ds_imod(int, int);
+#ifdef __cplusplus
+}
+#endif
+#define SPL_DIV(a, b) ds_idiv((a), (b))
+#else
+#define SPL_DIV(a, b) ((a) / (b))
+#endif
 extern u32 data_020a4d30;
 
