 /* Fills size bytes with the halfword data. */
+#ifdef _MSC_VER
+/* The ROM's own C body from before main made this file asm (src/MultiStore16.c at the
+   pin, byte-matched then); the port compiles it. */
+void MIi_CpuClear16(u16 data, void *destp, u32 size) {
+    s32 i = 0;
+    for (;;) {
+        if (i < (s32)size) {
+            *(u16 *)((u8 *)destp + i) = data;
+            i += 2;
+        } else
+            break;
+    }
+}
+#else
 asm void MIi_CpuClear16(u16 data, void *destp, u32 size) {
     mov r3, #0
 loop:
@@ -23,8 +37,22 @@
     blt loop
     bx lr
 }
+#endif
 
 /* Copies size bytes one halfword at a time. */
+#ifdef _MSC_VER
+/* The ROM's own C body from before main made this file asm (src/MultiCopyHalf.c at the
+   pin, byte-matched then); the port compiles it under CMake's MultiCopyHalf_rom rename. */
+void MIi_CpuCopy16(const void *srcp, void *destp, u32 size) {
+    s32 offset = 0;
+    for (;;) {
+        if (offset >= (s32)size)
+            break;
+        *(u16 *)((u32)destp + offset) = *(const u16 *)((u32)srcp + offset);
+        offset += 2;
+    }
+}
+#else
 asm void MIi_CpuCopy16(const void *srcp, void *destp, u32 size) {
     mov ip, #0
 loop:
@@ -35,8 +63,10 @@
     blt loop
     bx lr
 }
+#endif
 
