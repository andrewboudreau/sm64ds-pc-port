diff --git a/src/engine/gx/G3X.cpp b/src/engine/gx/G3X.cpp
--- a/src/engine/gx/G3X.cpp
+++ b/src/engine/gx/G3X.cpp
@@ -24,7 +24,8 @@
  * MMIO dereference through the host's register model. G3X_ClearFifo keeps
  * its literal addresses for that reason (a register macro from a header
  * would reach the host unrewritten). The rest calls SDK code the host build
- * doesn't link, so it sits under #ifndef _MSC_VER.
+ * doesn't link, so it sits under #ifndef _MSC_VER. (Port patch: the host
+ * builds it all; see the _MSC_VER block below the includes.)
  */
 #include "nitro/gx/g3x.h"
 #include "nitro/gx/g3imm.h"
@@ -38,7 +39,33 @@
 void GXi_NopClearFifo128_(unsigned addr);
 }
 
-#ifndef _MSC_VER
+#ifdef _MSC_VER
+/* Host: every body in this file builds. The registers with a side effect
+   (GXSTAT and the geometry command ports) go through the host's register
+   model, the way the pin's per-function copies reached it after hostgen
+   rewrote their literal addresses; the plain latches (DISP3DCNT, the clear,
+   fog, edge and toon registers, BG0OFS) stay mapped-window stores, which the
+   renderer reads at draw time. */
+#include "ntr/mmio.h"
+#undef REG_GXSTAT
+#undef REG_MTX_MODE
+#undef REG_MTX_POP
+#undef REG_MTX_IDENTITY
+#undef REG_POLYGON_ATTR
+#undef REG_SHININESS
+#undef REG_END_VTXS
+#define REG_GXSTAT       NTR_MMIO(u32, 0x04000600)
+#define REG_MTX_MODE     NTR_MMIO(u32, 0x04000440)
+#define REG_MTX_POP      NTR_MMIO(u32, 0x04000448)
+#define REG_MTX_IDENTITY NTR_MMIO(u32, 0x04000454)
+#define REG_POLYGON_ATTR NTR_MMIO(u32, 0x040004a4)
+#define REG_SHININESS    NTR_MMIO(u32, 0x040004d0)
+#define REG_END_VTXS     NTR_MMIO(u32, 0x04000504)
+#undef reg_G3_TEXIMAGE_PARAM
+#undef reg_G3_TEXPLTT_BASE
+#define reg_G3_TEXIMAGE_PARAM NTR_MMIO(u32, 0x040004a8)
+#define reg_G3_TEXPLTT_BASE   NTR_MMIO(u32, 0x040004ac)
+#endif
 
 /* The SDK's g3x.h inlines this file uses that the shared header leaves out
  * (an inline body there renumbers its includers' @NNN symbols). */
@@ -93,8 +120,6 @@
     reg_G3_TEXPLTT_BASE = 0;
 }
 
-#endif
