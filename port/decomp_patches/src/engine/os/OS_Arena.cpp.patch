@@ -36,8 +36,15 @@
 
 /* NitroSDK linker constants: the address is the value (the LCF assigns
  * SDK_SYS_STACKSIZE = 0 and SDK_IRQ_STACKSIZE = 0x600). */
+#ifdef _MSC_VER
+/* host: MSVC cannot give a symbol an absolute address, so the two LCF
+ * values stand in as constants (the casts below read them unchanged). */
+#define SDK_SYS_STACKSIZE 0
+#define SDK_IRQ_STACKSIZE 0x600
+#else
 extern void SDK_IRQ_STACKSIZE(void);
 extern void SDK_SYS_STACKSIZE(void);
+#endif
 
