+#ifdef _MSC_VER
+    /* Host: the handlers are cast to (unsigned char *, int, int), but most take
+       fewer arguments, and MSVC's __thiscall callee pops only its own. On the
+       cartridge the arguments ride in registers and a short handler ignores
+       them; here a short handler leaves the extra words on the stack and this
+       frame returns through them (command 22, func_ov002_020f26d4, takes none:
+       the opening's first KuppaScript record faulted at eip 0). The call goes
+       through hal/scene_boot.cpp's port_thiscall3_keep_esp, which puts the
+       stack pointer back after it. The member pointer is split into its code
+       address and this-adjustment, the two words MSVC stores for this class. */
+    {
+        union { PMF3 pmf; struct { void *fn; int adj; } raw; } handler;
+        typedef char PMF3_is_two_words[sizeof(PMF3) == 8 ? 1 : -1];
+        handler.pmf = sCommandTable[p[6]];
+        port_thiscall3_keep_esp((char *)this + handler.raw.adj, handler.raw.fn,
+                                p + 7, a2, a3);
+    }
+#else
     (this->*sCommandTable[p[6]])(p + 7, a2, a3);
+#endif
 }
 
