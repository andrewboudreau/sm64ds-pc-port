+#ifdef _MSC_VER
+    virtual void Destructor1();   /* D1 */
+    virtual void Destructor0();   /* D0 */
+    ~daStarGate_c() {}   /* no slot */
+#else
+    virtual ~daStarGate_c() {}   /* D1 and D0 */
+#endif
 
