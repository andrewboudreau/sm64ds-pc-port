 #define NITRO_HW_REGISTERS_H
 
 #include "types.h"
+
+/* host: a register spelled through one of the REG_ macros below is a plain
+ * volatile store or load, and the host maps the I/O window as plain memory,
+ * so a write that starts hardware (the GXFIFO and the geometry command ports,
+ * the divider and square-root units, VRAMCNT, IF's write-one-to-clear) would
+ * latch and trigger nothing. tools/hostgen.py routes literal register
+ * addresses spelled in a source file through NTR_MMIO, but it does not expand
+ * macros, so since these names were centralised here the TUs it generates
+ * stopped reaching the register model for them. In a hostgen'd TU (it
+ * includes ntr/mmio.h first, so NTR_MMIO is defined) each REG_ name is the
+ * same NTR_MMIO proxy hostgen would have written; every other build keeps
+ * the plain volatile lvalue. */
+#if defined(_MSC_VER) && defined(__cplusplus) && defined(NTR_MMIO)
+#define NTR_HWREG(T, A) NTR_MMIO(T, A)
+#else
+#define NTR_HWREG(T, A) (*(volatile T *)(A))
+#endif
 
